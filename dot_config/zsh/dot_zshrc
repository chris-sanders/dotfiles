# Setup antidote
source ${ZDOTDIR}/antidote/antidote.zsh
antidote load ${ZDOTDIR}/zsh_plugins.txt

# Create tmux by default in a regular interactive terminal. Agent-launched
# shells stay detached so coding tools can manage their own terminal sessions.
if [[ $- == *i* && -z "$TMUX" && -z "${ZSH_NO_AUTO_TMUX:-}" \
      && -z "${T3CODE_THREAD_ID:-}" && -z "${CODEX_SESSION_ID:-}" \
      && -z "${CODEX_THREAD_ID:-}" ]]; then
  session=$(tmux list-sessions -F "#{session_attached} #{session_name}" 2>/dev/null | grep "^0" | cut -d " " -f2 | head -n 1)
  if [ -n "$session" ]; then
    tmux attach-session -t "$session" 2>/dev/null
  else
    tmux new-session 2>/dev/null
  fi
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.config/zsh/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# aliases
alias watch="watch "
alias vim=nvim

# Use nvim
export EDITOR=nvim
export VISUAL=nvim

# Auto-created fzf completion
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Enable direnv
eval "$(direnv hook zsh)"
export DIRENV_LOG_FORMAT=""

# To customize prompt, run `p10k configure` or edit ~/.config/zsh/.p10k.zsh.
[[ ! -f ~/.config/zsh/.p10k.zsh ]] || source ~/.config/zsh/.p10k.zsh

# Source /etc/profile if it exists
if [ -f /etc/profile ]; then
  source /etc/profile
fi
